---
import MainLayout from "../layouts/Layout.astro";
---

<MainLayout
  title="Skills | Shivan Tillekeratne"
  description="Technical skills of Shivan Tillekeratne across artificial intelligence, machine learning, programming, software engineering, databases, and development tools."
>

  <section class="mx-auto max-w-7xl px-6 py-20">

    <!-- Page Header -->
    <div class="max-w-3xl">
      <p class="text-sm font-medium uppercase tracking-wider text-gray-500">
        Skills
      </p>

      <h1 class="mt-2 text-4xl font-bold tracking-tight text-gray-900 md:text-5xl">
        Technologies and tools I work with.
      </h1>

      <p class="mt-6 text-lg leading-8 text-gray-600">
        A collection of technologies, programming languages, frameworks,
        databases, and development tools that I have worked with through
        academic projects and professional experience.
      </p>
    </div>


    <!-- AI & Machine Learning -->
    <div class="mt-20">

      <h2 class="text-2xl font-semibold text-gray-900">
        AI & Machine Learning
      </h2>

      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">

        <div class="rounded-xl border border-gray-200 p-5">
          <h3 class="font-semibold text-gray-900">
            Machine Learning
          </h3>

          <p class="mt-2 text-sm leading-6 text-gray-600">
            Supervised learning, classification, preprocessing,
            model evaluation, and imbalanced data handling.
          </p>
        </div>

        <div class="rounded-xl border border-gray-200 p-5">
          <h3 class="font-semibold text-gray-900">
            Deep Learning
          </h3>

          <p class="mt-2 text-sm leading-6 text-gray-600">
            Deep learning approaches for computer vision and
            intelligent systems.
          </p>
        </div>

        <div class="rounded-xl border border-gray-200 p-5">
          <h3 class="font-semibold text-gray-900">
            NLP & LLM Applications
          </h3>

          <p class="mt-2 text-sm leading-6 text-gray-600">
            Natural language processing, prompt engineering,
            and AI-powered conversational systems.
          </p>
        </div>

        <div class="rounded-xl border border-gray-200 p-5">
          <h3 class="font-semibold text-gray-900">
            Computer Vision
          </h3>

          <p class="mt-2 text-sm leading-6 text-gray-600">
            Image and video processing, optical flow,
            segmentation, and activity recognition.
          </p>
        </div>

        <div class="rounded-xl border border-gray-200 p-5">
          <h3 class="font-semibold text-gray-900">
            Explainable AI
          </h3>

          <p class="mt-2 text-sm leading-6 text-gray-600">
            Exploring techniques for improving the interpretability
            and understanding of AI models.
          </p>
        </div>

        <div class="rounded-xl border border-gray-200 p-5">
          <h3 class="font-semibold text-gray-900">
            AI Automation
          </h3>

          <p class="mt-2 text-sm leading-6 text-gray-600">
            Designing AI-powered workflows, assistants, and
            automation solutions.
          </p>
        </div>

      </div>

    </div>


    <!-- Programming -->
    <div class="mt-20 border-t border-gray-100 pt-16">

      <h2 class="text-2xl font-semibold text-gray-900">
        Programming
      </h2>

      <div class="mt-6 flex flex-wrap gap-3">

        <span class="rounded-md border border-gray-200 px-4 py-2 text-sm text-gray-700">
          Python
        </span>

        <span class="rounded-md border border-gray-200 px-4 py-2 text-sm text-gray-700">
          Java
        </span>

        <span class="rounded-md border border-gray-200 px-4 py-2 text-sm text-gray-700">
          C
        </span>

        <span class="rounded-md border border-gray-200 px-4 py-2 text-sm text-gray-700">
          JavaScript
        </span>

        <span class="rounded-md border border-gray-200 px-4 py-2 text-sm text-gray-700">
          HTML
        </span>

        <span class="rounded-md border border-gray-200 px-4 py-2 text-sm text-gray-700">
          CSS
        </span>

      </div>

    </div>


    <!-- Web & Backend -->
    <div class="mt-16">

      <h2 class="text-2xl font-semibold text-gray-900">
        Web & Backend
      </h2>

      <div class="mt-6 flex flex-wrap gap-3">

        <span class="rounded-md border border-gray-200 px-4 py-2 text-sm text-gray-700">
          React
        </span>

        <span class="rounded-md border border-gray-200 px-4 py-2 text-sm text-gray-700">
          Django
        </span>

        <span class="rounded-md border border-gray-200 px-4 py-2 text-sm text-gray-700">
          FastAPI
        </span>

        <span class="rounded-md border border-gray-200 px-4 py-2 text-sm text-gray-700">
          REST APIs
        </span>

      </div>

    </div>


    <!-- Databases -->
    <div class="mt-16">

      <h2 class="text-2xl font-semibold text-gray-900">
        Databases
      </h2>

      <div class="mt-6 flex flex-wrap gap-3">

        <span class="rounded-md border border-gray-200 px-4 py-2 text-sm text-gray-700">
          MySQL
        </span>

        <span class="rounded-md border border-gray-200 px-4 py-2 text-sm text-gray-700">
          Microsoft SQL Server
        </span>

        <span class="rounded-md border border-gray-200 px-4 py-2 text-sm text-gray-700">
          MongoDB
        </span>

      </div>

    </div>


    <!-- Tools -->
    <div class="mt-16 border-t border-gray-100 pt-16">

      <h2 class="text-2xl font-semibold text-gray-900">
        Tools & Development Environment
      </h2>

      <div class="mt-6 flex flex-wrap gap-3">

        <span class="rounded-md border border-gray-200 px-4 py-2 text-sm text-gray-700">
          Git
        </span>

        <span class="rounded-md border border-gray-200 px-4 py-2 text-sm text-gray-700">
          GitHub
        </span>

        <span class="rounded-md border border-gray-200 px-4 py-2 text-sm text-gray-700">
          Jira
        </span>

        <span class="rounded-md border border-gray-200 px-4 py-2 text-sm text-gray-700">
          Figma
        </span>

        <span class="rounded-md border border-gray-200 px-4 py-2 text-sm text-gray-700">
          Canva
        </span>

        <span class="rounded-md border border-gray-200 px-4 py-2 text-sm text-gray-700">
          IntelliJ IDEA
        </span>

        <span class="rounded-md border border-gray-200 px-4 py-2 text-sm text-gray-700">
          CLion
        </span>

        <span class="rounded-md border border-gray-200 px-4 py-2 text-sm text-gray-700">
          Visual Studio
        </span>

        <span class="rounded-md border border-gray-200 px-4 py-2 text-sm text-gray-700">
          Cursor
        </span>

        <span class="rounded-md border border-gray-200 px-4 py-2 text-sm text-gray-700">
          Ubuntu
        </span>

        <span class="rounded-md border border-gray-200 px-4 py-2 text-sm text-gray-700">
          Windows
        </span>

      </div>

    </div>

  </section>

</MainLayout>