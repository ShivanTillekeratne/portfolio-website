---
import MainLayout from "../layouts/Layout.astro";
---

<MainLayout
  title="Leadership & Activities | Shivan Tillekeratne"
  description="Leadership, extracurricular activities, achievements, and interests of Shivan Tillekeratne."
>

  <section class="mx-auto max-w-7xl px-6 py-20">

    <!-- Page Header -->
    <div class="max-w-3xl">
      <p class="text-sm font-medium uppercase tracking-wider text-gray-500">
        Leadership & Activities
      </p>

      <h1 class="mt-2 text-4xl font-bold tracking-tight text-gray-900 md:text-5xl">
        Leadership beyond technical work.
      </h1>

      <p class="mt-6 text-lg leading-8 text-gray-600">
        Alongside my academic and professional work, I have been involved
        in student leadership, community activities, organizations,
        sports, and competitive programming.
      </p>
    </div>


    <!-- Leadership -->
    <div class="mt-20">

      <p class="text-sm font-medium uppercase tracking-wider text-gray-500">
        Leadership
      </p>

      <h2 class="mt-2 text-3xl font-bold tracking-tight text-gray-900">
        Leadership Experience
      </h2>

      <div class="mt-10 space-y-10">

        <!-- SLAAI -->
        <article class="border-l-2 border-gray-200 pl-6">

          <div
            class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between"
          >

            <div>
              <h3 class="text-2xl font-semibold text-gray-900">
                President — SLAAI Student Chapter
              </h3>

              <p class="mt-1 font-medium text-gray-700">
                University of Moratuwa
              </p>
            </div>

            <p class="text-sm text-gray-500">
              2026 – Present
            </p>

          </div>

          <p class="mt-5 max-w-4xl leading-7 text-gray-600">
            Serving as President of the Sri Lankan Association for
            Artificial Intelligence Student Chapter at the University
            of Moratuwa.
          </p>

          <div class="mt-6">

            <h4 class="text-sm font-semibold uppercase tracking-wider text-gray-500">
              Current Initiatives
            </h4>

            <ul class="mt-3 list-disc space-y-2 pl-5 leading-7 text-gray-600">

              <li>
                Planning and organizing an AI-focused hackathon.
              </li>

              <li>
                Developing an AI workshop series for school students.
              </li>

              <li>
                Contributing to the development of the student chapter website.
              </li>

            </ul>

          </div>

        </article>


        <!-- Youth Society -->
        <article class="border-l-2 border-gray-200 pl-6">

          <div
            class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between"
          >

            <div>
              <h3 class="text-xl font-semibold text-gray-900">
                President — Youth Society
              </h3>

              <p class="mt-1 font-medium text-gray-700">
                Christ the King Church, Pannipitiya
              </p>
            </div>

            <p class="text-sm text-gray-500">
              2023 – 2024
            </p>

          </div>

        </article>


        <!-- Charity Coordinator -->
        <article class="border-l-2 border-gray-200 pl-6">

          <div
            class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between"
          >

            <div>
              <h3 class="text-xl font-semibold text-gray-900">
                Charity Coordinator
              </h3>

              <p class="mt-1 font-medium text-gray-700">
                Sri Lanka University Catholic Students' Movement,
                Colombo Region · University of Moratuwa
              </p>
            </div>

            <p class="text-sm text-gray-500">
              2023 – 2024
            </p>

          </div>

        </article>


        <!-- Batch Representative -->
        <article class="border-l-2 border-gray-200 pl-6">

          <div
            class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between"
          >

            <div>
              <h3 class="text-xl font-semibold text-gray-900">
                2nd Year Batch Representative
              </h3>

              <p class="mt-1 font-medium text-gray-700">
                Faculty of IT, University of Moratuwa
              </p>
            </div>

            <p class="text-sm text-gray-500">
              2022 – 2023
            </p>

          </div>

        </article>

      </div>

    </div>


    <!-- Organizations -->
    <div class="mt-20 border-t border-gray-100 pt-16">

      <p class="text-sm font-medium uppercase tracking-wider text-gray-500">
        Organizations
      </p>

      <h2 class="mt-2 text-3xl font-bold tracking-tight text-gray-900">
        Community & Organizational Activities
      </h2>

      <div class="mt-10 grid gap-6 md:grid-cols-2">

        <!-- Catholic Students Movement -->
        <article class="rounded-xl border border-gray-200 p-6">

          <h3 class="text-xl font-semibold text-gray-900">
            Sri Lanka University Catholic Students' Movement
          </h3>

          <p class="mt-3 leading-7 text-gray-600">
            Junior Committee Member, Colombo Region —
            University of Moratuwa.
          </p>

          <p class="mt-3 text-sm text-gray-500">
            2022 – 2023
          </p>

        </article>


        <!-- AIESEC -->
        <article class="rounded-xl border border-gray-200 p-6">

          <h3 class="text-xl font-semibold text-gray-900">
            AIESEC
          </h3>

          <p class="mt-3 leading-7 text-gray-600">
            Member of AIESEC at the University of Moratuwa.
          </p>

          <p class="mt-3 text-sm text-gray-500">
            2022 – 2023
          </p>

        </article>


        <!-- Science Union -->
        <article class="rounded-xl border border-gray-200 p-6">

          <h3 class="text-xl font-semibold text-gray-900">
            Science Union
          </h3>

          <p class="mt-3 leading-7 text-gray-600">
            Vice Secretary of the Science Union at St. Joseph's College,
            Colombo 10.
          </p>

          <p class="mt-3 text-sm text-gray-500">
            2019
          </p>

        </article>


        <!-- Bible Society -->
        <article class="rounded-xl border border-gray-200 p-6">

          <h3 class="text-xl font-semibold text-gray-900">
            Bible Society & Sinhala Union
          </h3>

          <p class="mt-3 leading-7 text-gray-600">
            Member of the Bible Society and Sinhala Union at
            St. Joseph's College, Colombo 10.
          </p>

          <p class="mt-3 text-sm text-gray-500">
            2016 – 2017
          </p>

        </article>

      </div>

    </div>


    <!-- Competitive Programming -->
    <div class="mt-20 border-t border-gray-100 pt-16">

      <p class="text-sm font-medium uppercase tracking-wider text-gray-500">
        Achievements
      </p>

      <h2 class="mt-2 text-3xl font-bold tracking-tight text-gray-900">
        Competitive Programming
      </h2>

      <div class="mt-10 grid gap-6 md:grid-cols-2">

        <!-- Coderush 2023 -->
        <article class="rounded-xl border border-gray-200 p-6">

          <p class="text-sm font-medium text-gray-500">
            2023
          </p>

          <h3 class="mt-2 text-xl font-semibold text-gray-900">
            Coderush
          </h3>

          <p class="mt-3 leading-7 text-gray-600">
            Organized by INTECS-UoM.
          </p>

          <p class="mt-4 font-medium text-gray-900">
            8th Place — LogicLegends
          </p>

        </article>


        <!-- Coderush 2022 -->
        <article class="rounded-xl border border-gray-200 p-6">

          <p class="text-sm font-medium text-gray-500">
            2022
          </p>

          <h3 class="mt-2 text-xl font-semibold text-gray-900">
            Coderush
          </h3>

          <p class="mt-3 leading-7 text-gray-600">
            Organized by INTECS-UoM.
          </p>

          <p class="mt-4 font-medium text-gray-900">
            48th Place — CodeKillers
          </p>

        </article>

      </div>

    </div>


    <!-- Sports & Interests -->
    <div class="mt-20 border-t border-gray-100 pt-16">

      <p class="text-sm font-medium uppercase tracking-wider text-gray-500">
        Sports & Interests
      </p>

      <h2 class="mt-2 text-3xl font-bold tracking-tight text-gray-900">
        Beyond academics and technology
      </h2>

      <div class="mt-10 grid gap-6 md:grid-cols-2">

        <!-- Athletics -->
        <article class="rounded-xl border border-gray-200 p-6">

          <h3 class="text-xl font-semibold text-gray-900">
            Athletics
          </h3>

          <p class="mt-3 leading-7 text-gray-600">
            Participated in athletics at St. Joseph's College,
            Colombo 10.
          </p>

          <p class="mt-3 text-sm text-gray-500">
            2015 – 2019
          </p>

        </article>


        <!-- Cricket -->
        <article class="rounded-xl border border-gray-200 p-6">

          <h3 class="text-xl font-semibold text-gray-900">
            Club Cricket
          </h3>

          <p class="mt-3 leading-7 text-gray-600">
            Participated in club cricket with NCC.
          </p>

          <p class="mt-3 text-sm text-gray-500">
            2013 – 2015
          </p>

        </article>

      </div>

      <div class="mt-8 flex flex-wrap gap-3">

        <span class="rounded-md border border-gray-200 px-4 py-2 text-sm text-gray-700">
          Cricket
        </span>

        <span class="rounded-md border border-gray-200 px-4 py-2 text-sm text-gray-700">
          Music
        </span>

        <span class="rounded-md border border-gray-200 px-4 py-2 text-sm text-gray-700">
          Travelling
        </span>

      </div>

    </div>

  </section>

</MainLayout>