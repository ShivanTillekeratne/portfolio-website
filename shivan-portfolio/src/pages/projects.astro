---
import MainLayout from "../layouts/Layout.astro";
---

<MainLayout
  title="Projects | Shivan Tillekeratne"
  description="Selected artificial intelligence, machine learning, software engineering, and research projects by Shivan Tillekeratne."
>

  <!-- Page Header -->
  <section class="mx-auto max-w-7xl px-6 py-20">

    <div class="max-w-3xl">
      <p class="text-sm font-medium uppercase tracking-wider text-gray-500">
        Projects
      </p>

      <h1 class="mt-2 text-4xl font-bold tracking-tight text-gray-900 md:text-5xl">
        Building AI systems and software for real-world problems.
      </h1>

      <p class="mt-6 text-lg leading-8 text-gray-600">
        A selection of academic, research, and software projects that
        reflect my experience across artificial intelligence, machine
        learning, automation, and software engineering.
      </p>
    </div>


    <!-- Research & AI Projects -->
    <div class="mt-20">

      <p class="text-sm font-medium uppercase tracking-wider text-gray-500">
        Featured Projects
      </p>

      <h2 class="mt-2 text-3xl font-bold tracking-tight text-gray-900">
        AI, Machine Learning & Research
      </h2>

      <div class="mt-10 space-y-12">

        <!-- Human Activity Recognition -->
        <article class="border-t border-gray-200 pt-8">

          <h3 class="text-2xl font-semibold text-gray-900">
            Video-Based Human Activity Recognition
          </h3>

          <p class="mt-4 max-w-4xl text-lg leading-8 text-gray-600">
            A research-oriented project exploring human activity recognition
            from video using optical flow, segmentation, and deep learning
            techniques.
          </p>

          <div class="mt-6">
            <h4 class="text-sm font-semibold uppercase tracking-wider text-gray-500">
              Technologies
            </h4>

            <p class="mt-2 text-gray-700">
              Python · PyTorch · PyTorchVideo · OpenCV · RAFT · SAM 2
            </p>
          </div>

          <div class="mt-6">
            <h4 class="text-sm font-semibold uppercase tracking-wider text-gray-500">
              Focus
            </h4>

            <p class="mt-2 max-w-4xl leading-7 text-gray-600">
              Video understanding, optical flow, segmentation, deep learning,
              and explainable AI.
            </p>
          </div>

          <div class="mt-6">
            <a
              href="https://drive.google.com/drive/folders/1g9hNIDUIBkuTwdgugu9Wk2tCSn2rnBZJ?usp=drive_link"
              class="text-sm font-medium text-gray-700 transition hover:text-gray-900 hover:underline"
            >
              Project details →
            </a>
          </div>

        </article>


        <!-- Medical Fraud Detection -->
        <article class="border-t border-gray-200 pt-8">

          <h3 class="text-2xl font-semibold text-gray-900">
            AI-Assisted Medical Fraud Detection
          </h3>

          <p class="mt-4 max-w-4xl text-lg leading-8 text-gray-600">
            A machine learning system designed to assist in identifying
            potentially fraudulent medical insurance claims.
          </p>

          <div class="mt-6">
            <h4 class="text-sm font-semibold uppercase tracking-wider text-gray-500">
              Technologies
            </h4>

            <p class="mt-2 text-gray-700">
              Python · Django · React · MongoDB · scikit-learn · SMOTE · Random Forest
            </p>
          </div>

          <div class="mt-6">
            <h4 class="text-sm font-semibold uppercase tracking-wider text-gray-500">
              Focus
            </h4>

            <p class="mt-2 max-w-4xl leading-7 text-gray-600">
              Machine learning, data preprocessing, class imbalance,
              fraud detection, and full-stack AI application development.
            </p>
          </div>

          <div class="mt-6">
            <a
              href="https://github.com/ShivanTillekeratne/AI_Assisted_Medical_Fraud_Detection_System"
              class="text-sm font-medium text-gray-700 transition hover:text-gray-900 hover:underline"
            >
              Project details →
            </a>
          </div>

        </article>


        <!-- Automated Key Management -->
        <article class="border-t border-gray-200 pt-8">

          <h3 class="text-2xl font-semibold text-gray-900">
            Automated Key Management System
          </h3>

          <p class="mt-4 max-w-4xl text-lg leading-8 text-gray-600">
            An IoT-based system designed to automate physical key management
            and access control through embedded hardware and a web-based
            management system.
          </p>

          <div class="mt-6">
            <h4 class="text-sm font-semibold uppercase tracking-wider text-gray-500">
              Technologies
            </h4>

            <p class="mt-2 text-gray-700">
              Arduino C · PHP · MySQL
            </p>
          </div>

          <div class="mt-6">
            <h4 class="text-sm font-semibold uppercase tracking-wider text-gray-500">
              Focus
            </h4>

            <p class="mt-2 max-w-4xl leading-7 text-gray-600">
              IoT, embedded systems, access control, hardware integration,
              and web-based system management.
            </p>
          </div>

          <div class="mt-6">
            <a
              href="https://github.com/ShivanTillekeratne/Automated-Key-Management-System"
              class="text-sm font-medium text-gray-700 transition hover:text-gray-900 hover:underline"
            >
              Project details →
            </a>
          </div>

        </article>

      </div>

    </div>

  </section>

</MainLayout>