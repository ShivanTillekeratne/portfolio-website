---
import MainLayout from "../layouts/Layout.astro";
---

<MainLayout
  title="Contact | Shivan Tillekeratne"
  description="Contact Shivan Tillekeratne for AI engineering opportunities, research collaborations, and professional projects."
>

  <section class="mx-auto max-w-7xl px-6 py-20">

    <!-- Header -->
    <div class="max-w-3xl">

      <p class="text-sm font-medium uppercase tracking-wider text-gray-500">
        Contact
      </p>

      <h1 class="mt-2 text-4xl font-bold tracking-tight text-gray-900 md:text-5xl">
        Let's connect.
      </h1>

      <p class="mt-6 text-lg leading-8 text-gray-600">
        Whether you're reaching out about an AI engineering opportunity,
        research collaboration, or an interesting project, I'd be happy
        to connect.
      </p>

    </div>


    <!-- Contact Information -->
    <div class="mt-16 grid gap-6 md:grid-cols-2">

      <!-- Email -->
      <a
        href="mailto:lssatillekeratne@gmail.com"
        class="group rounded-xl border border-gray-200 p-6 transition hover:-translate-y-1 hover:border-gray-300 hover:shadow-md"
      >

        <p class="text-sm font-medium uppercase tracking-wider text-gray-500">
          Email
        </p>

        <h2 class="mt-2 text-lg font-semibold text-gray-900">
          lssatillekeratne@gmail.com
        </h2>

        <p class="mt-3 text-sm text-gray-600">
          Send me an email →
        </p>

      </a>


      <!-- LinkedIn -->
      <a
        href="https://www.linkedin.com/in/shivan-tillekeratne"
        target="_blank"
        rel="noopener noreferrer"
        class="group rounded-xl border border-gray-200 p-6 transition hover:-translate-y-1 hover:border-gray-300 hover:shadow-md"
      >

        <p class="text-sm font-medium uppercase tracking-wider text-gray-500">
          LinkedIn
        </p>

        <h2 class="mt-2 text-lg font-semibold text-gray-900">
          Connect on LinkedIn
        </h2>

        <p class="mt-3 text-sm text-gray-600">
          View my professional profile →
        </p>

      </a>


      <!-- GitHub -->
      <a
        href="https://github.com/ShivanTillekeratne"
        target="_blank"
        rel="noopener noreferrer"
        class="group rounded-xl border border-gray-200 p-6 transition hover:-translate-y-1 hover:border-gray-300 hover:shadow-md"
      >

        <p class="text-sm font-medium uppercase tracking-wider text-gray-500">
          GitHub
        </p>

        <h2 class="mt-2 text-lg font-semibold text-gray-900">
          ShivanTillekeratne
        </h2>

        <p class="mt-3 text-sm text-gray-600">
          Explore my code and projects →
        </p>

      </a>


      <!-- Location -->
      <div
        class="rounded-xl border border-gray-200 p-6"
      >

        <p class="text-sm font-medium uppercase tracking-wider text-gray-500">
          Location
        </p>

        <h2 class="mt-2 text-lg font-semibold text-gray-900">
          Colombo, Sri Lanka
        </h2>

        <p class="mt-3 text-sm text-gray-600">
          Open to connecting with people and organizations internationally.
        </p>

      </div>

    </div>


    <!-- CV -->
    <div class="mt-16 border-t border-gray-100 pt-16">

      <div class="max-w-3xl">

        <p class="text-sm font-medium uppercase tracking-wider text-gray-500">
          Curriculum Vitae
        </p>

        <h2 class="mt-2 text-3xl font-bold tracking-tight text-gray-900">
          Want to know more?
        </h2>

        <p class="mt-4 leading-7 text-gray-600">
          You can also download my CV for a more detailed overview of
          my professional experience, education, projects, technical
          skills, and activities.
        </p>

        <div class="mt-6">

          <a
            href="/cv/Shivan_Tillekeratne_CV.pdf"
            download
            class="inline-flex rounded-md bg-gray-900 px-5 py-3 text-sm font-medium text-white transition hover:bg-gray-700"
          >
            Download CV
          </a>

        </div>

      </div>

    </div>


    <!-- Final CTA -->
    <div class="mt-20 border-t border-gray-100 pt-16">

      <p class="max-w-2xl text-lg leading-8 text-gray-600">
        I'm particularly interested in opportunities involving
        artificial intelligence, machine learning, intelligent systems,
        and applied AI research.
      </p>

      <div class="mt-6">

        <a
          href="mailto:lssatillekeratne@gmail.com"
          class="text-sm font-medium text-gray-700 transition hover:text-gray-900 hover:underline"
        >
          Send me an email →
        </a>

      </div>

    </div>

  </section>

</MainLayout>