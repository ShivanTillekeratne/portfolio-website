---
interface Props {
  title: string;
  description: string;
  label?: string;
}

const {
  title,
  description,
  label = "Research",
} = Astro.props;
---

<article class="border-l-2 border-gray-200 pl-6">
  <p class="text-sm font-medium uppercase tracking-wider text-gray-500">
    {label}
  </p>

  <h3 class="mt-2 text-xl font-semibold text-gray-900">
    {title}
  </h3>

  <p class="mt-3 max-w-3xl leading-7 text-gray-600">
    {description}
  </p>
</article>