---
interface Props {
  title: string;
  description: string;
  technologies: string;
  href?: string;
}

const { title, description, technologies, href } = Astro.props;
---

<article
  class="flex h-full flex-col rounded-xl border border-gray-200 bg-white p-6 transition hover:-translate-y-1 hover:shadow-md"
>
  <h3 class="text-lg font-semibold text-gray-900">
    {title}
  </h3>

  <p class="mt-3 flex-grow leading-7 text-gray-600">
    {description}
  </p>

  <p class="mt-5 text-sm text-gray-500">
    {technologies}
  </p>

  {href && (
    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-5 inline-flex text-sm font-medium text-gray-700 transition hover:text-gray-900 hover:underline"
    >
      View Project →
    </a>
  )}
</article>