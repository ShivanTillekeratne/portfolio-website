---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Shivan Tillekeratne — AI Engineer and Artificial Intelligence graduate.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width"
    />

    <meta
      name="description"
      content={description}
    />

    <meta
      name="generator"
      content={Astro.generator}
    />

    <title>{title}</title>
  </head>

  <body class="min-h-screen bg-white text-gray-900">

    <Navbar />

    <main>
      <slot />
    </main>

    <Footer />

  </body>
</html>